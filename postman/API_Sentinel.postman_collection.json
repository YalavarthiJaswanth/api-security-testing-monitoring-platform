          }
        },
        {
          "name": "Register Target API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.api && jsonData.api.id) {",
                  "    pm.environment.set(\"apiId\", jsonData.api.id);",
                  "    pm.collectionVariables.set(\"apiId\", jsonData.api.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Payment Service API\",\n  \"baseUrl\": \"http://localhost:5050\",\n  \"description\": \"Core payment processing REST API\",\n  \"environment\": \"development\",\n  \"authType\": \"bearer\",\n  \"credentials\": {\n    \"token\": \"sentinel-test-token-2026\"\n  },\n  \"isLabApi\": true,\n  \"endpoints\": [\n    {\n      \"path\": \"/api/v1/users\",\n      \"method\": \"GET\",\n      \"summary\": \"List users\",\n      \"authRequired\": true\n    },\n    {\n      \"path\": \"/api/v1/transfer\",\n      \"method\": \"POST\",\n      \"summary\": \"Funds transfer\",\n      \"authRequired\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/apis",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "apis"
              ]
            }
          }
        },
        {
          "name": "Get API Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/apis/{{apiId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "apis",
                "{{apiId}}"
              ]
            }
          }
        },
        {
          "name": "Export API as Postman Collection",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/apis/{{apiId}}/postman",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "apis",
                "{{apiId}}",
                "postman"
              ]
            }
          }
        },
        {
          "name": "Import OpenAPI / Swagger Spec",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specContent\": \"openapi: \\\"3.0.0\\\"\\ninfo:\\n  title: Sample API\\n  version: 1.0.0\\npaths:\\n  /users:\\n    get:\\n      summary: Get users\\n      responses:\\n        \\\"200\\\":\\n          description: OK\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/apis/import-openapi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "apis",
                "import-openapi"
              ]
            }
          }
        }
      ]
