    {
      "name": "4. Interactive API Testing Proxy",
      "item": [
        {
          "name": "Send Real Request via SSRF Safe Proxy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"http://localhost:5050/api/v1/users\",\n  \"method\": \"GET\",\n  \"headers\": {\n    \"Accept\": \"application/json\"\n  },\n  \"allowLocalLab\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/test/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "test",
                "request"
              ]
            }
          }
        }
      ]
