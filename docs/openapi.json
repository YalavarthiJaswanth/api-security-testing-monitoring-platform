{
  "openapi": "3.0.3",
  "info": {
    "title": "API Sentinel - Security Testing & Monitoring Platform API",
    "version": "1.0.0",
    "description": "Enterprise-grade API Security Testing & Continuous Monitoring Platform.\n    \nFeatures:\n- Automated OWASP API Security Top 10 (2023) vulnerability scanning\n- Continuous latency & uptime health monitoring with alert thresholds\n- Cryptographic credential management (AES-256-GCM)\n- SSRF-protected interactive API testing proxy\n- Webhook alert notifications with HMAC-SHA256 signatures\n- Dynamic Postman collection exports & OpenAPI 3.0 spec import/export\n- Isolated Vulnerable Lab & attack simulation environment",
    "contact": {
      "name": "API Sentinel Security Team",
      "url": "https://github.com/YalavarthiJaswanth/api-security-testing-monitoring-platform"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Local Development Server (HTTP)"
    },
    {
      "url": "https://localhost:5443",
      "description": "Local Secure Server (HTTPS)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token obtained from /api/v1/auth/login"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "security_engineer",
              "viewer"
            ]
          }
        }
      },
      "ApiEndpoint": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "/api/v1/users"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "OPTIONS",
              "HEAD"
            ],
            "example": "GET"
          },
          "summary": {
            "type": "string",
            "example": "List all users"
          },
          "authRequired": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ApiTarget": {
        "type": "object",
        "required": [
          "name",
          "baseUrl"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Customer Management API"
          },
          "baseUrl": {
            "type": "string",
            "example": "https://api.example.com"
          },
          "description": {
            "type": "string",
            "example": "Production microservice for customers"
          },
          "environment": {
            "type": "string",
            "enum": [
              "development",
              "staging",
              "production"
            ],
            "example": "production"
          },
          "authType": {
            "type": "string",
            "enum": [
              "none",
              "bearer",
              "apiKey",
              "basic"
            ],
            "example": "bearer"
          },
          "endpointCount": {
            "type": "integer",
            "example": 12
          },
          "isLabApi": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Scan": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "apiId": {
            "type": "string"
          },
          "scanType": {
            "type": "string",
            "enum": [
              "full_owasp",
              "quick_audit",
              "auth_only",
              "rate_limit"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "durationMs": {
            "type": "number"
          },
          "findingsCount": {
            "type": "integer"
          },
          "severityCounts": {
            "type": "object",
            "properties": {
              "critical": {
                "type": "integer"
              },
              "high": {
                "type": "integer"
              },
              "medium": {
                "type": "integer"
              },
              "low": {
                "type": "integer"
              },
              "informational": {
                "type": "integer"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Finding": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "scanId": {
            "type": "string"
          },
          "apiId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "example": "Broken Object Level Authorization (BOLA)"
          },
          "owaspCategory": {
            "type": "string",
            "example": "API1:2023 - Broken Object Level Authorization"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "endpoint": {
            "type": "string",
            "example": "/api/v1/orders/102"
          },
          "method": {
            "type": "string",
            "example": "GET"
          },
          "evidence": {
            "type": "object"
          },
          "explanation": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "mitigated",
              "in_review",
              "false_positive"
            ]
          }
        }
      },
      "Webhook": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Slack Security Alerts"
          },
          "url": {
            "type": "string",
            "example": "https://hooks.slack.com/services/..."
          },
          "secret": {
            "type": "string",
            "example": "whsec_7493a8d8e0e..."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "scan.completed",
                "scan.failed",
                "finding.detected",
                "monitoring.alert",
                "monitoring.recovered",
                "*"
              ]
            }
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "customHeaders": {
            "type": "object"
          },
          "failureCount": {
            "type": "integer",
            "example": 0
          },
          "lastTriggered": {
            "type": "string",
            "format": "date-time"
          },
          "lastStatus": {
            "type": "integer",
            "example": 200
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Error description"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "System Health & Uptime Check",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Backend service and database status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "service": {
                      "type": "string",
                      "example": "api-sentinel-backend"
                    },
                    "uptimeSeconds": {
                      "type": "integer"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "example": "connected"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a new auditor or analyst account",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "email",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "analyst_bob"
                  },
                  "email": {
                    "type": "string",
                    "example": "bob@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "SecPass2026!"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "security_engineer",
                      "viewer"
                    ],
                    "default": "security_engineer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration successful"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "User already exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate and receive JWT token",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "lead@apisentinel.local"
                  },
                  "emailOrUsername": {
                    "type": "string",
                    "example": "lead@apisentinel.local"
                  },
                  "password": {
                    "type": "string",
                    "example": "SuperSecurePassword2026!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email/username and password required"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get currently authenticated user identity",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "User profile returned"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/apis": {
      "get": {
        "summary": "List all monitored API targets",
        "tags": [
          "API Management"
        ],
        "responses": {
          "200": {
            "description": "Array of API targets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "apis": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ApiTarget"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register a new target API for security scanning",
        "tags": [
          "API Management"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "baseUrl"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Online Payments API"
                  },
                  "baseUrl": {
                    "type": "string",
                    "example": "http://localhost:5050"
                  },
                  "description": {
                    "type": "string",
                    "example": "Core financial transactions service"
                  },
                  "environment": {
                    "type": "string",
                    "enum": [
                      "development",
                      "staging",
                      "production"
                    ],
                    "default": "development"
                  },
                  "authType": {
                    "type": "string",
                    "enum": [
                      "none",
                      "bearer",
                      "apiKey",
                      "basic"
                    ],
                    "default": "none"
                  },
                  "credentials": {
                    "type": "object",
                    "properties": {
                      "token": {
                        "type": "string",
                        "example": "sample-bearer-token"
                      }
                    }
                  },
                  "endpoints": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ApiEndpoint"
                    }
                  },
                  "openapiSpec": {
                    "type": "string"
                  },
                  "isLabApi": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API registered successfully"
          },
          "400": {
            "description": "Invalid target URL or SSRF violation"
          }
        }
      }
    },
    "/api/v1/apis/{id}": {
      "get": {
        "summary": "Get target API by ID",
        "tags": [
          "API Management"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API target details"
          },
          "404": {
            "description": "API not found"
          }
        }
      },
      "put": {
        "summary": "Update target API configuration",
        "tags": [
          "API Management"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "environment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated successfully"
          },
          "404": {
            "description": "API not found"
          }
        }
      },
      "delete": {
        "summary": "Delete target API and its associated scans/findings",
        "tags": [
          "API Management"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted successfully"
          },
          "404": {
            "description": "API not found"
          }
        }
      }
    },
    "/api/v1/apis/{id}/postman": {
      "get": {
        "summary": "Export API target endpoints as a Postman Collection (v2.1)",
        "tags": [
          "API Management",
          "Postman"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Postman Collection JSON",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "API not found"
          }
        }
      }
    },
    "/api/v1/apis/import-openapi": {
      "post": {
        "summary": "Parse and import OpenAPI / Swagger specification",
        "tags": [
          "API Management",
          "Swagger"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "specContent": {
                    "type": "string",
                    "example": "openapi: \"3.0.0\"\ninfo:\n  title: Sample Target API\n  version: 1.0.0\npaths:\n  /users:\n    get:\n      summary: Get users\n      responses:\n        \"200\":\n          description: OK"
                  },
                  "specUrl": {
                    "type": "string",
                    "example": "https://petstore.swagger.io/v2/swagger.json"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed endpoints list"
          },
          "400": {
            "description": "Parse error or SSRF blocked"
          }
        }
      }
    },
    "/api/v1/test/execute": {
      "post": {
        "summary": "Execute real HTTP request via SSRF-safe interactive proxy",
        "tags": [
          "Interactive Testing"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "example": "http://localhost:5050/api/v1/users"
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "DELETE",
                      "PATCH",
                      "OPTIONS",
                      "HEAD"
                    ],
                    "default": "GET"
                  },
                  "headers": {
                    "type": "object",
                    "example": {
                      "Accept": "application/json"
                    }
                  },
                  "body": {
                    "type": "string",
                    "example": ""
                  },
                  "timeout": {
                    "type": "integer",
                    "default": 5000
                  },
                  "allowLocalLab": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Live HTTP response with status, latency, headers, and body"
          },
          "400": {
            "description": "SSRF blocked or invalid parameters"
          }
        }
      }
    },
    "/api/v1/scans": {
      "get": {
        "summary": "List historical security scans",
        "tags": [
          "Security Scans"
        ],
        "responses": {
          "200": {
            "description": "List of scans"
          }
        }
      }
    },
    "/api/v1/scans/trigger": {
      "post": {
        "summary": "Trigger OWASP API Security testing scan",
        "tags": [
          "Security Scans"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "apiId"
                ],
                "properties": {
                  "apiId": {
                    "type": "string",
                    "description": "MongoDB ObjectId of registered API target"
                  },
                  "scanType": {
                    "type": "string",
                    "enum": [
                      "full_owasp",
                      "quick_audit",
                      "auth_only",
                      "rate_limit"
                    ],
                    "default": "full_owasp"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scan completed and findings saved"
          },
          "400": {
            "description": "Invalid API ID"
          },
          "404": {
            "description": "Target API not found"
          }
        }
      }
    },
    "/api/v1/scans/{id}": {
      "get": {
        "summary": "Get scan details, severity counts, and execution logs",
        "tags": [
          "Security Scans"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan details"
          },
          "404": {
            "description": "Scan not found"
          }
        }
      }
    },
    "/api/v1/findings": {
      "get": {
        "summary": "Query security findings with severity & status filters",
        "tags": [
          "Vulnerability Findings"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "severity",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "apiId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching findings list"
          }
        }
      }
    },
    "/api/v1/findings/{id}": {
      "get": {
        "summary": "Get finding details by ID",
        "tags": [
          "Vulnerability Findings"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Finding details"
          },
          "404": {
            "description": "Finding not found"
          }
        }
      }
    },
    "/api/v1/findings/{id}/status": {
      "patch": {
        "summary": "Update finding remediation status",
        "tags": [
          "Vulnerability Findings"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "resolved",
                      "mitigated",
                      "in_review",
                      "false_positive"
                    ],
                    "example": "resolved"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Finding status updated"
          },
          "400": {
            "description": "Invalid status"
          },
          "404": {
            "description": "Finding not found"
          }
        }
      }
    },
    "/api/v1/monitoring": {
      "get": {
        "summary": "List active continuous monitoring configurations",
        "tags": [
          "Monitoring"
        ],
        "responses": {
          "200": {
            "description": "Monitoring configs"
          }
        }
      }
    },
    "/api/v1/monitoring/{id}": {
      "get": {
        "summary": "Get monitoring configuration by ID or API ID",
        "tags": [
          "Monitoring"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Monitoring config details"
          },
          "404": {
            "description": "Monitoring config not found"
          }
        }
