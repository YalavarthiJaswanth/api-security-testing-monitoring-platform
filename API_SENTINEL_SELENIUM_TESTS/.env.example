# Base URL of the running API Sentinel frontend application
SENTINEL_BASE_URL=http://localhost:3000

# Optional pre-existing demo user credentials for Login test
# Never commit real production secrets; copy to .env if overriding defaults.
SENTINEL_TEST_USERNAME=
SENTINEL_TEST_PASSWORD=

# Browser execution settings (visible by default for live demonstrations)
SELENIUM_HEADLESS=false
SELENIUM_TIMEOUT_SECONDS=15
