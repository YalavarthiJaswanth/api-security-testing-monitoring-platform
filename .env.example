# API Sentinel - Environment Configuration Example

# Backend Service
PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/api_sentinel
JWT_SECRET=api-sentinel-jwt-super-secret-key-production-strength-2026
JWT_EXPIRES_IN=7d
ENCRYPTION_MASTER_KEY=12345678901234567890123456789012

# Microservices Communication
SECURITY_ENGINE_URL=http://localhost:8000
VULNERABLE_LAB_URL=http://localhost:5050

# Security Policies
SSRF_STRICT=true
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,vulnerable-lab
